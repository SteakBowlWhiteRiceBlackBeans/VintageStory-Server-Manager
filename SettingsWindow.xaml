<Window x:Class="VintageStory_Server_Manager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Server Executable" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerExeTextBox" Text="%appdata%/Vintagestory/VintagestoryServer.exe" Height="24" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Width="80" Margin="8,0,0,0" Click="BrowseServerExe_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Launch Arguments" Margin="0,0,0,4"/>
            <TextBox x:Name="LaunchArgsTextBox" Height="24" VerticalContentAlignment="Center"/>
            <TextBlock Text="I suggest to modify the config file otherwise you can enter arugments here. Example --port=42420" FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="VintageStoryServerData folder location" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DataFolderTextBox" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Text="--DataPath is configured by default and automatically applies this folder location." FontSize="11" Foreground="Gray" Margin="0,24,0,-20" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Browse..." Width="80" Margin="8,0,0,0" Click="BrowseDataFolder_Click"/>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Automation" FontWeight="Bold" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox x:Name="AutoSaveCheckBox" Content="Auto Save Minutes: " VerticalAlignment="Center" Checked="AutoSaveCheckBox_Checked" Unchecked="AutoSaveCheckBox_Unchecked"/>
            <TextBox x:Name="AutoSaveMinutesTextBox" Width="50" Height="22" Text="15" IsEnabled="False" VerticalContentAlignment="Center"/>
            <TextBlock Text="Don't set Save / Backup to same minute interval as it may cause issues. i.e both every 5 minutes." FontSize="11" Foreground="Gray" Margin="20,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox x:Name="AutoBackupCheckBox" Content="Auto Backup Minutes: " VerticalAlignment="Center" Checked="AutoBackupCheckBox_Checked" Unchecked="AutoBackupCheckBox_Unchecked"/>
            <TextBox x:Name="AutoBackupMinutesTextBox" Width="50" Height="22" Text="60" IsEnabled="False" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Max backup files   0 = unlimited" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="MaxBackupFilesTextBox" Width="50" Height="22" Text="0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Max backup folder size (GB)  0 = unlimited" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="MaxBackupSizeTextBox" Width="50" Height="22" Text="0" VerticalContentAlignment="Center"/>
            <TextBlock Text="Deletes oldest backup when limit is reached" FontSize="11" Foreground="Gray" Margin="20,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="AutoRestartCheckBox" Content="Auto Restart Time: " VerticalAlignment="Center" Checked="AutoRestartCheckBox_Checked" Unchecked="AutoRestartCheckBox_Unchecked"/>
                <ComboBox x:Name="RestartHourCombo" Width="45" Height="22" IsEnabled="False"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="RestartMinuteCombo" Width="45" Height="22" IsEnabled="False"/>
                <ComboBox x:Name="RestartAmPmCombo" Width="50" Height="22" IsEnabled="False" Margin="4,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Reboot announcement will be sent in chat 15 minutes prior and every 3 minutes after" FontSize="11" Foreground="Gray" Margin="20,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="9" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom">
            <Button Content="Open Server Config" Height="28" Width="138" Margin="0,0,220,0" Click="Button_Click"/>
            <Button Content="Reset to Defaults" Width="120" Height="28" Margin="0,0,8,0" Click="ResetDefaultsButton_Click"/>
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="80" Height="28" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>

    </Grid>
</Window>